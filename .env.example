# Use your own infrastructure. Never commit populated environment files.
# Vercel proxy: URL of your authenticated Cloud Run service.
GCP_CLOUD_RUN_URL=
# Base64-encoded service account JSON. Secret; grant only required permissions.
GCP_SERVICE_ACCOUNT_KEY=
# Backend only: 32 random bytes encoded as 64 hexadecimal characters.
UPLOAD_TOKEN_SECRET=
GCS_BUCKET=your-development-bucket
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Authorization for the cleanup proxy.
CRON_SECRET=
# Shared only between Vercel and Cloud Run, for backend cleanup authorization.
CLEANUP_SECRET=
# Google Cloud Storage uses Application Default Credentials separately.

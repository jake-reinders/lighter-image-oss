{
  "name": "lighter-image-oss",
  "version": "1.0.0",
  "description": "Image compression application source code; infrastructure not included",
  "type": "module",
  "scripts": {
    "build": "./node_modules/.bin/tsc && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json && esbuild src/upload.ts --bundle --format=iife --global-name=BlobUpload --outfile=public/upload.bundle.js --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "png",
    "jpg",
    "compression",
    "image",
    "quantization",
    "optimization"
  ],
  "license": "MIT",
  "dependencies": {
    "esbuild": "0.28.2",
    "jose": "^6.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
